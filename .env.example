# AI Song Studio Environment Configuration
# Copy this file to .env and populate with your actual credentials.
# NEVER commit the actual .env file.

# ============================================================
# MUSIC GENERATION PROVIDERS
# ============================================================

# ElevenLabs (Music generation)
# https://elevenlabs.io
ELEVENLABS_API_KEY=

# Google Lyria (Music generation)
# https://cloud.google.com/ai/generative-ai/docs/music
GOOGLE_LYRIA_API_KEY=
GOOGLE_LYRIA_PROJECT_ID=

# Suno.ai (Music generation)
# https://app.suno.ai
SUNO_API_KEY=

# Udio (Music generation)
# https://www.udio.com
UDIO_API_KEY=

# ============================================================
# VOICE & SPEECH PROVIDERS
# ============================================================

# Google Cloud Speech-to-Text
GOOGLE_SPEECH_API_KEY=

# Deepgram (Speech-to-text, voice synthesis)
# https://deepgram.com
DEEPGRAM_API_KEY=

# ============================================================
# LOCAL MODEL MANAGEMENT
# ============================================================

# Local model cache directory (optional, uses default if not set)
LOCAL_MODELS_DIR=

# ============================================================
# APPLE CORE AI
# ============================================================

# Core AI is device-local and requires no API key.
# Configuration is handled through .aimodel bundles.

# ============================================================
# WEB/BACKEND CONFIGURATION
# ============================================================

# Backend server
BACKEND_URL=http://localhost:8080
BACKEND_PORT=8080

# Frontend
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000

# Database (if applicable)
DATABASE_URL=

# ============================================================
# DEVELOPMENT
# ============================================================

# Enable verbose logging
DEBUG=false

# Producer mode: local, cloud, or hybrid
PRODUCER_MODE=hybrid

# Deployment environment
NODE_ENV=development
